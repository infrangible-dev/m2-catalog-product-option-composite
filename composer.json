{
    "name": "infrangible/m2-catalog-product-option-composite",
    "description": "Custom options for bundle and configurable products: tie options to variants or bundle selections, show them inside the bundle options and let customers edit them per bundle item in the cart.",
    "type": "magento2-module",
    "version": "6.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Bundle products",
        "Cart and checkout",
        "custom options for configurable products",
        "custom options for bundle products",
        "options per variant"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-option-composite",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-bundle-option-selection": "~2.0.0",
        "infrangible/m2-bundle-option-wrapper": "~2.0.0",
        "infrangible/m2-catalog-product-option": "~2.0.0",
        "infrangible/m2-catalog-product-option-price": "~3.0.0",
        "infrangible/m2-catalog-product-option-wrapper": "~2.0.1",
        "infrangible/m2-catalog-product-swatches": "~2.0.0",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-bundle": "~101.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-checkout": "~100.4.0",
        "magento/module-config": "~101.2.0",
        "magento/module-configurable-product": "~100.4.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-quote": "~101.2.0",
        "magento/module-store": "~101.1.0",
        "magento/module-ui": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionComposite\\": "src"
        }
    }
}
